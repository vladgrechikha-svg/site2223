# Copy this file to .env and fill in your real values.
# NEVER commit .env to git, NEVER paste it into a chat, NEVER put these
# values into any frontend/site code. This file only lives on your server.

PORT=3000

# --- Prom.ua ---
# Seller cabinet -> API settings -> generate a token
PROM_API_TOKEN=

# --- Rozetka Marketplace ---
# Seller cabinet credentials used to obtain a 24h Bearer token
ROZETKA_LOGIN=
ROZETKA_PASSWORD=

# --- Nova Poshta ---
NOVA_POSHTA_API_KEY=
# Your sender info (from your Nova Poshta contract/cabinet) - required to create waybills
NP_SENDER_REF=
NP_SENDER_CONTACT_REF=
NP_SENDER_PHONE=
NP_SENDER_CITY_REF=
NP_SENDER_WAREHOUSE_REF=

# --- Telegram notifications ---
# Create a bot via @BotFather, then message it once and use
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often (in minutes) to poll Prom/Rozetka for new orders
SYNC_INTERVAL_MINUTES=5
